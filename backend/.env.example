PORT=5000
NODE_ENV=development

# Use either Aiven connection string OR local MySQL values
AIVEN_CONNECTION=mysql://username:password@host:port/database_name?ssl=true
# OR
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_local_mysql_password
DB_NAME=resources_schedule_db

# JWT config
JWT_SECRET=your_super_secret_key_here

# Optional if you want to use another db URL explicitly
# DATABASE_URL=mysql://username:password@host:port/database_name
